#!/usr/bin/env bash
#
# Connect to a cloud PC with native FreeRDP instead of the Chrome web client.
#
#   omarchy-cloudpc bss
#
# Reads ~/.local/share/avd/<client>.rdp. Those files carry tenant ids, an armpath and
# a Microsoft signature, so they stay out of this repo -- download one per resource from
# the Windows App web client ("Download .rdp" on the desktop tile) and drop it there.
#
# Why native FreeRDP: a Chrome renderer plus GPU process per cloud PC is the single
# largest memory consumer in a full four-context session.
#
# The window class is forced via SDL_APP_ID so each client gets its own stable app_id
# (cloudpc-bss, cloudpc-f5, ...). Without it SDL picks its own and every cloud PC
# would share one class, which is the same trap chrome-* falls into -- see the note in
# omarchy-context about why chrome windows have to be placed by script.
#
# Known limitation: connecting costs TWO browser logins, one for the gateway token and
# one for the per-host AVD access token. FreeRDP does not cache them between runs.
#
# Per-host-pool auth differs, and the .rdp says how. Do NOT normalise these:
#   bss      enablerdsaadauth:i:1                          -> token auth, no prompt
#   f5       targetisaadjoined:i:1 + enablerdsaadauth:i:0   -> works as shipped
#   lanvera  neither property, needs an EMPTY domain (/d: in lanvera.args) plus
#            username:s: in its .rdp; FreeRDP otherwise defaults the domain to AzureAD
#            and the host answers 0x52E
# Adding enablerdsaadauth to a pool that omits it does NOT help -- on Lanvera it made the
# ARM connections response come back unparseable, which looks like a FreeRDP bug and is
# not. Equally, do not add username:s:/domain:s: to bss or f5: they ride into the
# ARM request and broke it there. See installations/install-apps.sh.
#
# That same "unparseable ARM response" also happens on its own, with correct config:
#
#   [ERROR][com.freerdp.core.gateway.arm] - [arm_fill_gateway_parameters]:
#           Response data is not valid JSON: [12:347:5832] '}' expected near ':' [<buffer>]
#   [ERROR][com.freerdp.core.connection] - [rdp_client_connect]:
#           error retrieving ARM configuration
#
# It is TRANSIENT -- retry before changing anything. There is no on-screen error: the
# Entra login window appears as usual and the session window just never opens.
#
# What it actually is (traced 2026-09-24 against two captured failures): the gateway
# serves a MALFORMED body for POST /api/arm/v2/connections. It is pretty-printed, and the
# two shapes differ structurally rather than by random corruption:
#
#   good  line 12 "gatewayConnectionToken": "<475 chars base64url>",
#         then gatewayLoadBalancerToken, gatewayLoadBalancerMethod,
#         clientRendezvousLocation and azureInstanceNetworkMetadata on their own lines.
#   bad   line 12 "gatewayConnectionToken": "<315 chars>": "{\"interface\":[...]}",
#         -- TWO values behind ONE key. The token stops at 315 chars, the next three
#         fields are gone entirely, and azureInstanceNetworkMetadata's value survives
#         with its key name missing. The parser completes the member, meets the second
#         ':' and rejects the whole document.
#
# The error's third number is a byte offset into the body; subtract the start of line 12
# to get the column it reports.
#
# It is the SERVER. Not FreeRDP, not the transport. Two failures six minutes apart were
# byte-identical in shape -- same 315-char token, same 582-byte line 12, same quote
# columns -- yet differed elsewhere (redirectedAuthBlob), so they were distinct responses
# generated the same broken way. A lost chunk would cut somewhere different every time.
# The response IS chunked (com.freerdp.core.gateway.http at DEBUG logs "chunked encoding
# end of stream received"), but the decoder reassembled exactly what arrived.
#
# Unconfirmed but fits everything seen: the gateway hands out ARRAffinity cookies, so it
# is load balanced. If one backend serves the broken shape, affinity would pin a client
# to it for a while -- which is why a cloud PC can fail repeatedly, then work later, while
# another connects fine in between. "Wait and retry" may really be "wait for a different
# backend".
#
# Do NOT read the byte offset as a config-vs-transient tell. An earlier version of this
# comment claimed a DIFFERENT offset each time means transient; that is wrong. f5 failed
# at the identical offset three runs straight and then connected with no change at all,
# and lanvera gave 5838, 5838, 5832, 5831, 5831. The offset only tracks field lengths.
#
# FreeRDP will not retry this for you. arm.c returns the malformed body as HTTP 200 ->
# arm_handle_request_ok -> parse fails -> *retry = FALSE. The retry loop in
# arm_resolve_endpoint only spins when retry is set, and the sole setter is an HTTP 400
# carrying Code == E_PROXY_ORCHESTRATION_LB_SESSIONHOST_DEALLOCATED. So a bad token costs
# a fresh browser login every time. Just launch again.
#
# To capture the response instead of guessing, run with OMARCHY_CLOUDPC_DEBUG=1 (see
# below). Do NOT use /log-filters:...:TRACE for this -- an earlier version of this comment
# recommended it and it does not work: arm.c parses BEFORE it logs, so a body that fails
# to parse is never logged at any level, and TRACE additionally writes the Authorization
# bearer token and RDmiGatewayToken to the log. /log-filters:...:DEBUG is the useful one,
# but it only prints the body on a SUCCESSFUL parse.

set -euo pipefail

CLIENT="${1:?usage: omarchy-cloudpc <client>   (e.g. bss)}"
RDP="$HOME/.local/share/avd/${CLIENT}.rdp"
MONITOR="${2:-DP-5}"

# Launched from a keybind or omarchy-context there is no terminal, and both of those
# throw stdout/stderr away -- a failed connect then just silently never appears. Keep a
# log per client instead, previous run kept as .prev. A run from a real terminal still
# prints normally.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-cloudpc"
if [ ! -t 1 ]; then
	mkdir -p "$LOG_DIR"
	[ -f "$LOG_DIR/${CLIENT}.log" ] && mv -f "$LOG_DIR/${CLIENT}.log" "$LOG_DIR/${CLIENT}.log.prev"
	exec >"$LOG_DIR/${CLIENT}.log" 2>&1
fi
echo "=== $(date -Is) omarchy-cloudpc $CLIENT ==="

if [ ! -f "$RDP" ]; then
	echo "omarchy-cloudpc: missing $RDP" >&2
	command -v notify-send >/dev/null &&
		notify-send -u critical "Cloud PC" "No .rdp for '$CLIENT'. Download it from the Windows App web client into ~/.local/share/avd/${CLIENT}.rdp"
	exit 1
fi

# Size to the target monitor rather than hardcoding. DP-5 is portrait via transform=1,
# so its logical size is height x width, and the bar's reserved strip comes off the top.
# +dynamic-resolution means this only has to be close: the session follows the tile.
size=$(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$MONITOR" '
  .[] | select(.name == $m)
  | (if (.transform % 2) == 1 then {w: .height, h: .width} else {w: .width, h: .height} end) as $d
  | (.scale // 1) as $s
  | "\((($d.w / $s) - .reserved[0] - .reserved[2]) | floor)x\((($d.h / $s) - .reserved[1] - .reserved[3]) | floor)"
' 2>/dev/null || true)
[ -n "${size:-}" ] && [ "$size" != "null" ] || size=1080x1894

export SDL_APP_ID="cloudpc-${CLIENT}"

# Optional per-client extra flags, one per line, in ~/.local/share/avd/<client>.args.
# Lanvera needs "/d:" there: FreeRDP defaults the domain to AzureAD (PR #11892), which
# its session host rejects with 0x52E -- an empty domain is what makes it authenticate.
# BSS and F5 must NOT get that, they carry real domains (GLOBAL, OLYMPUS).
extra=()
ARGS_FILE="$HOME/.local/share/avd/${CLIENT}.args"
if [ -f "$ARGS_FILE" ]; then
	while IFS= read -r line; do
		[ -n "$line" ] && [ "${line#\#}" = "$line" ] && extra+=("$line")
	done <"$ARGS_FILE"
fi

# Devices we do not want in a cloud PC session: printers, COM/parallel ports,
# smartcards, microphone, cameras, USB, drives and location. Clipboard is the only
# redirection that is wanted.
#
# This CANNOT be done with command line flags, and the obvious attempt backfires. The
# "-foo" form only turns something OFF for options declared COMMAND_LINE_VALUE_BOOL. The
# device options (printer, smartcard, serial, parallel, usb, drive) are VALUE_OPTIONAL,
# so "-smartcard" still marks the argument present and the post filter then calls
# freerdp_client_add_device_channel unconditionally -- see
# freerdp_client_command_line_post_filter_int in client/common/cmdline.c. The
# "-drives -smartcard" this script used to pass was therefore ENABLING smartcard
# redirection: every f5 log shows "registered [smartcard] device #1". "-drives" does
# clear RedirectDrives, being BOOL, but the .rdp's drivestoredirect:s:* had already added
# the share by name and the flag does not undo that, so gvfs was redirected as well.
# Camera and location have no command line option at all.
#
# So neutralise them at the source and run from a sanitised COPY of the .rdp. An empty
# string value is skipped outright by client/common/file.c (utils_str_is_empty guards
# every *storedirect property), which is exactly "off". The copy is regenerated on every
# run, so re-downloading the .rdp from the web client cannot quietly bring the devices
# back. The Microsoft signature is left in place untouched: FreeRDP does not verify it,
# and none of the gateway/ARM properties are altered -- only local redirection is.
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-cloudpc"
mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR"
SANITISED="$RUN_DIR/${CLIENT}.rdp"
(
	umask 077
	awk 'BEGIN { FS = ":" }
	{
		sub(/\r$/, "")
		if ($1 ~ /^(audiomode|redirectprinters|redirectcomports|redirectsmartcards|redirectdrives|redirectlocation|audiocapturemode|redirectclipboard|devicestoredirect|drivestoredirect|usbdevicestoredirect|camerastoredirect|encode redirected video capture|redirected video capture encoding quality)$/)
			next
		print $0 "\r"
	}
	END {
		print "redirectclipboard:i:1\r"
		print "redirectprinters:i:0\r"
		print "redirectcomports:i:0\r"
		print "redirectsmartcards:i:0\r"
		print "redirectdrives:i:0\r"
		print "redirectlocation:i:0\r"
		print "audiocapturemode:i:0\r"
		print "audiomode:i:2\r"
		print "devicestoredirect:s:\r"
		print "drivestoredirect:s:\r"
		print "usbdevicestoredirect:s:\r"
		print "camerastoredirect:s:\r"
	}' "$RDP" >"$SANITISED"
)

# -multimon:          the .rdp requests multimon, which is rejected outright when
#                     combined with an explicit /size ("Invalid or unsupported monitor
#                     configuration").
# no device flags:    every redirection except the clipboard is turned off in the
#                     sanitised .rdp above, NOT here. -microphone and -sound are the same
#                     trap as -smartcard: they are VALUE_OPTIONAL, so the minus form
#                     still ADDS the audin/rdpsnd channel. Read that comment before
#                     adding a flag for any device. Keeping the gvfs drive off also saves
#                     ~80s of logon that FSLogix spent mounting the profile container.
# keyboard grab:      left at its default (on). SDL3 implements
#                     zwp_keyboard_shortcuts_inhibit_manager_v1, which Hyprland honours
#                     per surface and drops on focus loss, so local keybinds keep
#                     working the moment you focus something else.
# /timeout:60000:     the AVD gateway holds POST /api/arm/v2/connections open while it
#                     orchestrates a session host, well past the default connect timeout.
# /prevent-session-lock:180: injects mouse motion every 180s so the remote
#                     Windows session does not idle-lock. Reconnecting is expensive here
#                     -- two browser logins, plus an FSLogix profile mount that took over
#                     two minutes on first use. Drop this flag if a client's policy
#                     expects the session to lock on idle. The interval is given
#                     EXPLICITLY on purpose: the value is optional, and left bare it
#                     swallowed the following argument -- Lanvera's /d: from its
#                     .args file -- which silently restored the AzureAD domain and
#                     broke the connect.
#
# Local idle is handled implicitly: the SDL client suppresses the local screensaver by
# default (SDL3 uses zwp_idle_inhibit_manager_v1, which Hyprland honours), so Omarchy
# will not lock while a cloud PC window is open. Add +sdl-allow-screensaver to get the
# normal lock-screen behaviour back.
# Which workspace this client's windows belong on, from ~/.local/share/avd/<client>.ws.
# Only used to park the login window; the session window itself is placed by the
# cloudpc-<client> rule in overrides/omarchy-overrides.lua.
WS_FILE="$HOME/.local/share/avd/${CLIENT}.ws"
TARGET_WS=""
[ -f "$WS_FILE" ] && TARGET_WS=$(tr -dc '0-9' <"$WS_FILE")

cmd=(sdl-freerdp3 "$SANITISED"
	/size:"$size"
	+dynamic-resolution
	-multimon
	/clipboard
	/timeout:60000
	/prevent-session-lock:180
	"${extra[@]}")

# OMARCHY_CLOUDPC_DEBUG=1 runs the client under gdb. It does two things:
#
#   1. captures the malformed ARM body described at the top of this file. It is the only
#      way to see a failing body: arm.c parses before it logs, so a body that does not
#      parse never reaches any log.
#   2. prints a full backtrace of every thread on any fatal signal, then continues so the
#      process still dies normally and systemd-coredump still records a core. This is for
#      the other failure mode -- the session window disappearing while the clipboard is
#      in use -- where there is nothing in the log and no visible error at all.
#
# For the clipboard case, add the channel's own logging on top, which needs no code here
# because wlog reads the environment:
#
#   WLOG_FILTER=com.freerdp.client.sdl.cliprdr:DEBUG,com.freerdp.channels.cliprdr.client:DEBUG,com.freerdp.client.common.cliprdr.file:DEBUG,com.freerdp.utils.cliprdr:DEBUG \
#     OMARCHY_CLOUDPC_DEBUG=1 omarchy-cloudpc lanvera
#
# Keep DEBUG, not TRACE: see the note above about TRACE writing bearer tokens to the log.
# The breakpoint is on WINPR_JSON_ParseWithLength, which is an exported symbol
# in libwinpr3 -- the Arch package is stripped, but a dynamic symbol is enough, so no
# debug build or rebuild is needed.
#
# x86-64 SysV: rdi = const char* value, rsi = size_t buffer_length.
#
# The filter takes large buffers whose second byte is not '"'. The ARM connections
# response is pretty-printed and starts "{\r\n"; the Entra token response is compact and
# starts {"token_type" -- that one is deliberately skipped, it carries an OAuth
# refresh_token. Dumps still contain redirectedAuthBlob and the gateway tokens, so the
# directory is 0700 and these are worth deleting once a failure has been read.
if [ "${OMARCHY_CLOUDPC_DEBUG:-0}" = 1 ]; then
	if ! command -v gdb >/dev/null; then
		echo "omarchy-cloudpc: OMARCHY_CLOUDPC_DEBUG=1 needs gdb installed" >&2
		exit 1
	fi
	DUMP_DIR="$LOG_DIR/arm-dumps"
	mkdir -p "$DUMP_DIR" && chmod 700 "$DUMP_DIR"
	stamp=$(date +%Y%m%d-%H%M%S)
	gdb_script=$(mktemp "${TMPDIR:-/tmp}/omarchy-cloudpc-gdb.XXXXXX")
	trap 'rm -f "$gdb_script"' EXIT
	cat >"$gdb_script" <<-'GDBEOF'
		set pagination off
		set confirm off
		set breakpoint pending on
		set follow-fork-mode parent
		set detach-on-fork on
		# glibc's setxid/timer signals and a broken pipe are normal here; stopping on
		# them would freeze the client for no reason.
		handle SIGPIPE nostop noprint pass
		handle SIG32 SIG33 SIG34 nostop noprint pass
		# A fatal signal (the clipboard disconnects were reported as the window simply
		# vanishing) prints every thread's stack and then lets the process die normally,
		# so systemd-coredump still gets its core.
		catch signal SIGSEGV SIGABRT SIGBUS SIGFPE SIGILL
		commands
		  printf "\n=== fatal signal caught ===\n"
		  thread apply all bt full
		  printf "=== end backtrace ===\n"
		  continue
		end
		set $n = 0
		break WINPR_JSON_ParseWithLength
		commands
		silent
		  if $rsi > 3000 && *(char *)($rdi + 1) != 34
		    set $n = $n + 1
		    printf "=== ARM JSON parse #%d len=%lu -> @PREFIX@-%d.json\n", $n, $rsi, $n
		    eval "dump binary memory @PREFIX@-%d.json 0x%lx 0x%lx", $n, $rdi, $rdi + $rsi
		  end
		  continue
		end
		run
		quit
	GDBEOF
	sed -i "s|@PREFIX@|$DUMP_DIR/${CLIENT}-${stamp}|g" "$gdb_script"
	echo "debug: ARM bodies -> $DUMP_DIR/${CLIENT}-${stamp}-N.json (contains tokens)"
	gdb -q -nx -x "$gdb_script" --args "${cmd[@]}" </dev/null &
else
	# stdbuf: wlog's console appender writes through stdio, so with stdout redirected to
	# the log file it is block buffered while stderr is not. Both land in the same file and
	# the result is lost and spliced lines -- an earlier f5 log contains
	# "[INFO][co[09:47:22:920]", one message cut in half by the other stream, and a
	# connected session whose gdi/logon lines never appeared at all because they were
	# still sitting in a 4K buffer. Line buffering both keeps the log readable and complete
	# while the session is still running, which is the whole point of having it.
	stdbuf -oL -eL "${cmd[@]}" &
fi
rdp_pid=$!

# The Entra login window is freerdp-webview-aad-helper for every client, with an
# identical title, and it maps wherever the pointer happens to be. With two connects in
# flight there is no way to tell which login belongs to which cloud PC. It is always a
# child of our own sdl-freerdp3 though, and Hyprland reports each window's pid, so claim
# the one whose process tree leads back to us and park it on this client's workspace.
# Walking ancestors rather than checking the parent directly is also what keeps this
# working under OMARCHY_CLOUDPC_DEBUG=1, where rdp_pid is gdb and the login window is a
# grandchild.
if [ -n "$TARGET_WS" ] && command -v jq >/dev/null; then
	(
		descends_from() { # $1 = pid, $2 = ancestor
			local p=$1 i=0
			while [ -n "$p" ] && [ "$p" != 0 ] && [ $i -lt 12 ]; do
				[ "$p" = "$2" ] && return 0
				p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null) || return 1
				i=$((i + 1))
			done
			return 1
		}
		claimed=" "
		for _ in $(seq 240); do
			kill -0 "$rdp_pid" 2>/dev/null || break
			while read -r addr wpid; do
				[ -n "$addr" ] || continue
				case "$claimed" in *" $addr "*) continue ;; esac
				if descends_from "$wpid" "$rdp_pid"; then
					hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1
					hyprctl dispatch "hl.dsp.window.move({ workspace = \"$TARGET_WS\", follow = true })" >/dev/null 2>&1
					claimed="$claimed$addr "
					echo "login window $addr -> workspace $TARGET_WS"
				fi
			done < <(hyprctl clients -j 2>/dev/null |
				jq -r '.[]|select(.class=="freerdp-webview-aad-helper")|"\(.address) \(.pid)"')
			sleep 0.5
		done
	) &
fi

wait "$rdp_pid"
