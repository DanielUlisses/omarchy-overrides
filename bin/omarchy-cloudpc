#!/usr/bin/env bash
#
# Connect to a cloud PC with native FreeRDP instead of the Chrome web client.
#
#   omarchy-cloudpc bss
#
# Reads ~/.local/share/avd/<client>.rdp. Those files carry tenant ids, an armpath and
# a Microsoft signature, so they stay out of this repo -- download one per resource from
# the Windows App web client ("Download .rdp" on the desktop tile) and drop it there.
#
# Why native FreeRDP: a Chrome renderer plus GPU process per cloud PC is the single
# largest memory consumer in a full four-context session.
#
# The window class is forced via SDL_APP_ID so each client gets its own stable app_id
# (cloudpc-bss, cloudpc-f5, ...). Without it SDL picks its own and every cloud PC
# would share one class, which is the same trap chrome-* falls into -- see the note in
# omarchy-context about why chrome windows have to be placed by script.
#
# Known limitation: connecting costs TWO browser logins, one for the gateway token and
# one for the per-host AVD access token. FreeRDP does not cache them between runs.
#
# Per-host-pool auth differs, and the .rdp says how. Do NOT normalise these:
#   bss      enablerdsaadauth:i:1                          -> token auth, no prompt
#   f5       targetisaadjoined:i:1 + enablerdsaadauth:i:0   -> works as shipped
#   lanvera  neither property, needs an EMPTY domain (/d: in lanvera.args) plus
#            username:s: in its .rdp; FreeRDP otherwise defaults the domain to AzureAD
#            and the host answers 0x52E
# Adding enablerdsaadauth to a pool that omits it does NOT help -- on Lanvera it made the
# ARM connections response come back unparseable, which looks like a FreeRDP bug and is
# not. Equally, do not add username:s:/domain:s: to bss or f5: they ride into the
# ARM request and broke it there. See installations/install-apps.sh.
#
# That same "unparseable ARM response" also happens on its own, with correct config:
#
#   [ERROR][com.freerdp.core.gateway.arm] - [arm_fill_gateway_parameters]:
#           Response data is not valid JSON: [...] invalid token near '...'
#   [ERROR][com.freerdp.core.connection] - [rdp_client_connect]:
#           error retrieving ARM configuration
#
# It is TRANSIENT -- retry before changing anything. On 2026-09-23 Lanvera failed this
# way twice in a row, then connected 17 minutes later with the same .rdp, same .args and
# the same binary; f5 connected normally in between. The tell that it is not config: the
# parse error lands at a DIFFERENT byte offset each time (a wrong .rdp property fails
# identically every run). There is no on-screen error either -- the Entra login window
# appears as usual and the session window just never opens.
#
# To see the actual response instead of guessing, add to ~/.local/share/avd/<client>.args:
#   /log-filters:com.freerdp.core.gateway.arm:TRACE
# which dumps the full ARM request and response into this script's log. REMOVE IT AFTER:
# that trace writes the Authorization bearer token and the RDmiGatewayToken values to the
# log in plaintext.

set -euo pipefail

CLIENT="${1:?usage: omarchy-cloudpc <client>   (e.g. bss)}"
RDP="$HOME/.local/share/avd/${CLIENT}.rdp"
MONITOR="${2:-DP-5}"

# Launched from a keybind or omarchy-context there is no terminal, and both of those
# throw stdout/stderr away -- a failed connect then just silently never appears. Keep a
# log per client instead, previous run kept as .prev. A run from a real terminal still
# prints normally.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-cloudpc"
if [ ! -t 1 ]; then
	mkdir -p "$LOG_DIR"
	[ -f "$LOG_DIR/${CLIENT}.log" ] && mv -f "$LOG_DIR/${CLIENT}.log" "$LOG_DIR/${CLIENT}.log.prev"
	exec >"$LOG_DIR/${CLIENT}.log" 2>&1
fi
echo "=== $(date -Is) omarchy-cloudpc $CLIENT ==="

if [ ! -f "$RDP" ]; then
	echo "omarchy-cloudpc: missing $RDP" >&2
	command -v notify-send >/dev/null &&
		notify-send -u critical "Cloud PC" "No .rdp for '$CLIENT'. Download it from the Windows App web client into ~/.local/share/avd/${CLIENT}.rdp"
	exit 1
fi

# Size to the target monitor rather than hardcoding. DP-5 is portrait via transform=1,
# so its logical size is height x width, and the bar's reserved strip comes off the top.
# +dynamic-resolution means this only has to be close: the session follows the tile.
size=$(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$MONITOR" '
  .[] | select(.name == $m)
  | (if (.transform % 2) == 1 then {w: .height, h: .width} else {w: .width, h: .height} end) as $d
  | (.scale // 1) as $s
  | "\((($d.w / $s) - .reserved[0] - .reserved[2]) | floor)x\((($d.h / $s) - .reserved[1] - .reserved[3]) | floor)"
' 2>/dev/null || true)
[ -n "${size:-}" ] && [ "$size" != "null" ] || size=1080x1894

export SDL_APP_ID="cloudpc-${CLIENT}"

# Optional per-client extra flags, one per line, in ~/.local/share/avd/<client>.args.
# Lanvera needs "/d:" there: FreeRDP defaults the domain to AzureAD (PR #11892), which
# its session host rejects with 0x52E -- an empty domain is what makes it authenticate.
# BSS and F5 must NOT get that, they carry real domains (GLOBAL, OLYMPUS).
extra=()
ARGS_FILE="$HOME/.local/share/avd/${CLIENT}.args"
if [ -f "$ARGS_FILE" ]; then
	while IFS= read -r line; do
		[ -n "$line" ] && [ "${line#\#}" = "$line" ] && extra+=("$line")
	done <"$ARGS_FILE"
fi

# -multimon:          the .rdp requests multimon, which is rejected outright when
#                     combined with an explicit /size ("Invalid or unsupported monitor
#                     configuration").
# -drives -smartcard: the .rdp asks for both; redirecting a gvfs drive added ~80s to
#                     logon while FSLogix mounted the profile container.
# keyboard grab:      left at its default (on). SDL3 implements
#                     zwp_keyboard_shortcuts_inhibit_manager_v1, which Hyprland honours
#                     per surface and drops on focus loss, so local keybinds keep
#                     working the moment you focus something else.
# /timeout:60000:     the AVD gateway holds POST /api/arm/v2/connections open while it
#                     orchestrates a session host, well past the default connect timeout.
# /prevent-session-lock:180: injects mouse motion every 180s so the remote
#                     Windows session does not idle-lock. Reconnecting is expensive here
#                     -- two browser logins, plus an FSLogix profile mount that took over
#                     two minutes on first use. Drop this flag if a client's policy
#                     expects the session to lock on idle. The interval is given
#                     EXPLICITLY on purpose: the value is optional, and left bare it
#                     swallowed the following argument -- Lanvera's /d: from its
#                     .args file -- which silently restored the AzureAD domain and
#                     broke the connect.
#
# Local idle is handled implicitly: the SDL client suppresses the local screensaver by
# default (SDL3 uses zwp_idle_inhibit_manager_v1, which Hyprland honours), so Omarchy
# will not lock while a cloud PC window is open. Add +sdl-allow-screensaver to get the
# normal lock-screen behaviour back.
# Which workspace this client's windows belong on, from ~/.local/share/avd/<client>.ws.
# Only used to park the login window; the session window itself is placed by the
# cloudpc-<client> rule in overrides/omarchy-overrides.lua.
WS_FILE="$HOME/.local/share/avd/${CLIENT}.ws"
TARGET_WS=""
[ -f "$WS_FILE" ] && TARGET_WS=$(tr -dc '0-9' <"$WS_FILE")

sdl-freerdp3 "$RDP" \
	/size:"$size" \
	+dynamic-resolution \
	-multimon \
	/clipboard \
	-drives \
	-smartcard \
	/timeout:60000 \
	/prevent-session-lock:180 \
	"${extra[@]}" &
rdp_pid=$!

# The Entra login window is freerdp-webview-aad-helper for every client, with an
# identical title, and it maps wherever the pointer happens to be. With two connects in
# flight there is no way to tell which login belongs to which cloud PC. It is always a
# child of our own sdl-freerdp3 though, and Hyprland reports each window's pid, so claim
# the one whose process tree leads back to us and park it on this client's workspace.
if [ -n "$TARGET_WS" ] && command -v jq >/dev/null; then
	(
		descends_from() { # $1 = pid, $2 = ancestor
			local p=$1 i=0
			while [ -n "$p" ] && [ "$p" != 0 ] && [ $i -lt 12 ]; do
				[ "$p" = "$2" ] && return 0
				p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null) || return 1
				i=$((i + 1))
			done
			return 1
		}
		claimed=" "
		for _ in $(seq 240); do
			kill -0 "$rdp_pid" 2>/dev/null || break
			while read -r addr wpid; do
				[ -n "$addr" ] || continue
				case "$claimed" in *" $addr "*) continue ;; esac
				if descends_from "$wpid" "$rdp_pid"; then
					hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1
					hyprctl dispatch "hl.dsp.window.move({ workspace = \"$TARGET_WS\", follow = true })" >/dev/null 2>&1
					claimed="$claimed$addr "
					echo "login window $addr -> workspace $TARGET_WS"
				fi
			done < <(hyprctl clients -j 2>/dev/null |
				jq -r '.[]|select(.class=="freerdp-webview-aad-helper")|"\(.address) \(.pid)"')
			sleep 0.5
		done
	) &
fi

wait "$rdp_pid"
