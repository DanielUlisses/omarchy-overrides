#!/bin/bash
# Per-client context switcher for Omarchy Quattro (Hyprland 0.56+).
#
#   omarchy-context switch <1-4>   move DP-5 + DP-6 to that context (repeat = next DP-5 row)
#   omarchy-context launch <1-4>   idempotently start that context's apps, then switch
#   omarchy-context quit   <1-4>   close that context's windows
#   omarchy-context toggle         advance the current context's DP-5 row
#   omarchy-context focus          fullscreen current window + toggle notification silencing
#   omarchy-context notes          omawrite overlay on special:notes
#
# Workspaces: DP-6 = 1..4 (dev), eDP-1 = 10 (never touched), and DP-5 = one app per
# workspace in three rows, because DP-5 is portrait now and two tiled windows on a
# 1080-wide panel are unusable:
#
#              ctx 1 Pythian   ctx 2 Lanvera   ctx 3 BSS        ctx 4 Personal
#   2n browser 21 chrome       22 chrome       23 chrome        24 chrome
#   3n chat    31 slack        32 teams        33 teams (BSS)   34 chrome (admin)
#   4n cloudpc 41 remmina      42 avd          43 avd           --
#
# SUPER+F<n> lands on that context's 2n and each repeat walks to the next row it
# actually uses, wrapping. Rows with no wired app (ctx 4 has no cloud PC, ctx 3's AVD
# URL may be unset) drop out of the cycle on their own -- see rows().
# Placement is owned by the window rules in overrides/omarchy-overrides.lua, except for
# Chrome windows -- see is_chrome() below for why those have to be placed here.
set -u

DEV=DP-6
COMMS=DP-5

CHROME='uwsm app -- google-chrome-stable'
# Cloud PC AVD web clients.
BSS_AVD='https://windows.cloud.microsoft/webclient/avd/21b5393e-0ca5-4788-9ad2-3dafc22b0377/a026d301-402a-4b1d-d40a-08d8386745f7#loginHint=daniel.Ulisses.external%40Beiersdorf.com'
LANVERA_AVD='https://windows.cloud.microsoft/webclient/avd/69350a1c-2543-4664-8ea9-d3850d5b2216/4b4019bc-77c4-408a-e788-08dbde32b101?endpointId=d136289c-954b-4134-92f0-ed117198fdbd#loginHint=TE.DU0816%40Lanvera.org'

# window class <TAB> workspace <TAB> launch command, one line per app.
apps() {
  case "$1" in
  1) cat <<EOF
chrome-pythian	21	$CHROME --profile-directory="Profile 1" --class=chrome-pythian
slack	31	uwsm app -- slack --enable-features=UseOzonePlatform --ozone-platform=wayland
org.remmina.Remmina	41	uwsm app -- remmina -c "/home/daniel/.local/share/remmina/group_rdp_pythian_172-16-0-16.remmina"
EOF
    ;;
  2) cat <<EOF
chrome-lanvera	22	$CHROME --profile-directory="Profile 2" --class=chrome-lanvera
teams-for-linux	32	uwsm app -- teams-for-linux
chrome-cloudpc-lanvera	42	omarchy-launch-webapp "$LANVERA_AVD" --profile-directory="Profile 2"
EOF
    ;;
  3) cat <<EOF
chrome-bss	23	$CHROME --profile-directory="Profile 3" --class=chrome-bss
teams-personal	33	uwsm app -- teams-for-linux --class=teams-personal --user-data-dir="/home/daniel/.config/teams-personal"
chrome-cloudpc-bss	43	${BSS_AVD:+omarchy-launch-webapp "$BSS_AVD" --profile-directory="Profile 3"}
EOF
    ;;
  4) cat <<EOF
chrome-personal	24	$CHROME --profile-directory="Default" --class=chrome-personal
chrome-admin	34	$CHROME --profile-directory="Profile 4" --class=chrome-admin
EOF
    ;;
  esac
}

# Chrome shares one process across profiles, so every normal window inherits the
# app_id of whichever profile started the process -- window rules cannot tell them
# apart. Anything labelled chrome-* is therefore placed by this script instead.
is_chrome() { case "$1" in chrome-*) return 0 ;; *) return 1 ;; esac; }
chrome_on_ws() { hyprctl clients -j | jq --arg w "$1" '[.[]|select(.workspace.name==$w and (.class|startswith("chrome-")))]|length'; }
chrome_wanted() { apps "$1" | awk -F'\t' -v w="$2" '$1 ~ /^chrome-/ && $2 == w && $3 != "" {n++} END {print n+0}'; }

active_ws() { hyprctl monitors -j | jq -r --arg m "$1" '.[]|select(.name==$m)|.activeWorkspace.name'; }
running() { hyprctl clients -j | jq -e --arg c "$1" 'any(.[]; .class==$c)' >/dev/null; }
go() { hyprctl dispatch "hl.dsp.focus({ workspace = \"$1\" })" >/dev/null; }

# Which context are we in? DP-6 is authoritative; fall back to DP-5, then Pythian.
# Every DP-5 workspace is <row><context>, so the context is always the second digit.
current() {
  case "$(active_ws $DEV)" in 1 | 2 | 3 | 4) active_ws $DEV; return ;; esac
  case "$(active_ws $COMMS)" in
  [234][1-4]) active_ws $COMMS | cut -c2 ;;
  *) echo 1 ;;
  esac
}

# The DP-5 rows this context actually uses, in cycle order. Reading them back out of
# apps() is what keeps the cycle honest: an entry with an empty command (the BSS cloud
# PC before its URL is set) is skipped here exactly as launch() skips it.
rows() { apps "$1" | awk -F'\t' '$3 != "" { print $2 }' | sort -nu; }

# Next DP-5 row: the one after whatever is showing, wrapping at the end. Landing from
# anywhere else -- another context, the dev monitor, a stray workspace -- starts at 2n.
next_row() {
  rows "$1" | awk -v cur="$(active_ws $COMMS)" '
    { row[NR] = $0; if ($0 == cur) at = NR }
    END { if (NR) print (at == 0 || at == NR) ? row[1] : row[at + 1] }
  '
}

# Advance DP-5 to its next row and actually focus it there -- go() grabs real keyboard
# focus (verified: it moves the input target even when the cursor sits elsewhere), so
# this alone is enough for actions that are only about DP-5.
advance_row() {
  local ws
  ws=$(next_row "$1")
  [ -n "$ws" ] && go "$ws"
}

# Context switch: advance DP-5, then land focus on the dev monitor too -- but only when
# this actually changes context. DP-6's *active workspace* already reads "$1" on a
# repeat SUPER+F<n> press (same context, just cycling the DP-5 row), yet DP-6 might not
# hold real keyboard focus (you could've been typing into DP-5 the whole time) -- so an
# unconditional go("$1") would silently steal focus back to DP-6 on every repeat, the
# same bug toggle had. Only a genuine cross-context jump earns the DP-6 focus move.
switch() {
  local was
  was=$(current)
  advance_row "$1"
  [ "$1" = "$was" ] || go "$1"
}

# hl.dsp.window.move has no `match`, so park = focus the window, then move the focused one.
park() {
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"$2\", follow = false })" >/dev/null
}

# Launch, wait for the window to map, then park it on its workspace.
place_new() {
  local before new addr
  before=$(hyprctl clients -j | jq -r '.[].address' | sort)
  setsid sh -c "$1" >/dev/null 2>&1 &
  for _ in $(seq 30); do
    sleep 0.5
    new=$(comm -13 <(echo "$before") <(hyprctl clients -j | jq -r '.[].address' | sort))
    [ -n "$new" ] && break
  done
  for addr in $new; do park "$addr" "$2"; done
}

# Window rules only fire at map time, so a window that was already open when a rule
# changed stays put. Drag any stragglers back rather than making you restart the app.
regroup() {
  local addr
  for addr in $(hyprctl clients -j | jq -r --arg c "$1" --arg w "$2" '.[]|select(.class==$c and .workspace.name!=$w)|.address'); do
    park "$addr" "$2"
  done
}

launch() {
  local class ws cmd
  while IFS=$'\t' read -r class ws cmd; do
    [ -n "$cmd" ] || continue # unwired entry, e.g. the BSS cloud PC before its URL is set
    if is_chrome "$class"; then
      # ponytail: no per-profile handle exists, so idempotency is "enough Chrome
      # windows already on that workspace". Close one of two and both relaunch.
      [ "$(chrome_on_ws "$ws")" -ge "$(chrome_wanted "$1" "$ws")" ] && continue
      place_new "$cmd" "$ws"
    elif running "$class"; then
      regroup "$class" "$ws"
    else
      setsid sh -c "$cmd" >/dev/null 2>&1 &
      sleep 0.8 # stagger: simultaneous Electron/RDP window mapping misplaces windows
    fi
  done < <(apps "$1")
  go "$(rows "$1" | head -1)" # launching always lands on the browser row, never mid-cycle
  go "$1"
}

quit() {
  local class ws _cmd addr
  while IFS=$'\t' read -r class ws _cmd; do
    if is_chrome "$class"; then
      # No usable class, so close by what is sitting on the workspace instead.
      for addr in $(hyprctl clients -j | jq -r --arg w "$ws" '.[]|select(.workspace.name==$w and (.class|startswith("chrome-")))|.address'); do
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
        hyprctl dispatch 'hl.dsp.window.close()' >/dev/null
      done
    else
      hyprctl dispatch "hl.dsp.window.close({ match = \"class:^($class)$\" })" >/dev/null
    fi
  done < <(apps "$1")
}

case "${1:-}" in
switch) switch "$2" ;;
launch) launch "$2" ;;
quit) quit "${2:-$(current)}" ;;
toggle) advance_row "$(current)" ;;
focus)
  hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "fullscreen" })' >/dev/null
  # ponytail: two independent states (per-window fullscreen, global DND flag). Pressing
  # F9 on a different window fullscreens it while flipping DND back off. Reconcile only
  # if that actually bites.
  omarchy toggle notification silencing
  ;;
notes)
  running omawrite || { setsid sh -c 'uwsm app -- omawrite' >/dev/null 2>&1 & sleep 1; }
  hyprctl dispatch 'hl.dsp.workspace.toggle_special("notes")' >/dev/null
  ;;
--dry-run)
  # Self-check: context -> workspace mapping and the comms/cloud flip.
  for n in 1 2 3 4; do
    [ "$(apps $n | wc -l)" -ge 2 ] || { echo "FAIL: context $n has no apps"; exit 1; }
    apps $n | awk -F'\t' 'NF!=3 { exit 1 }' || { echo "FAIL: context $n has a malformed app line"; exit 1; }
  done
  for n in 1 2 3 4; do
    [ "$(rows $n | wc -l)" = "$(rows $n | sort -u | wc -l)" ] || { echo "FAIL: context $n reuses a workspace"; exit 1; }
    [ "$(rows $n | cut -c2 | sort -u)" = "$n" ] || { echo "FAIL: context $n has a row on the wrong context digit"; exit 1; }
  done
  hyprctl() { echo '[{"name":"DP-5","activeWorkspace":{"name":"'"$FAKE_WS"'"}}]'; }
  FAKE_WS=1 && [ "$(next_row 2)" = 22 ] || { echo "FAIL: cold switch should start at the browser row"; exit 1; }
  FAKE_WS=22 && [ "$(next_row 2)" = 32 ] || { echo "FAIL: browser row should advance to chat"; exit 1; }
  FAKE_WS=32 && [ "$(next_row 2)" = 42 ] || { echo "FAIL: chat row should advance to the cloud PC"; exit 1; }
  FAKE_WS=42 && [ "$(next_row 2)" = 22 ] || { echo "FAIL: last row should wrap to the browser row"; exit 1; }
  FAKE_WS=21 && [ "$(next_row 2)" = 22 ] || { echo "FAIL: another context's row should not be a cycle position"; exit 1; }
  FAKE_WS=24 && [ "$(next_row 4)" = 34 ] || { echo "FAIL: Personal should advance to its admin browser"; exit 1; }
  FAKE_WS=34 && [ "$(next_row 4)" = 24 ] || { echo "FAIL: Personal has no cloud PC row to stop on"; exit 1; }
  FAKE_WS=33 && [ "$(next_row 3)" = "$([ -n "$BSS_AVD" ] && echo 43 || echo 23)" ] || { echo "FAIL: unwired BSS cloud PC should drop out of the cycle"; exit 1; }
  [ "$(chrome_wanted 4 24)" = 1 ] || { echo "FAIL: Personal should want 1 Chrome window on 24"; exit 1; }
  [ "$(chrome_wanted 3 43)" = "$([ -n "$BSS_AVD" ] && echo 1 || echo 0)" ] || { echo "FAIL: unwired BSS cloud PC should not be counted"; exit 1; }
  echo "ok"
  ;;
*)
  sed -n '2,12p' "$0"
  exit 1
  ;;
esac
