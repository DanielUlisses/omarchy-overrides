#!/bin/bash
# Desk switcher for Omarchy Quattro (Hyprland 0.56+).
#
#   omarchy-context vm <lanvera|bss|f5>        focus that cloud PC's workspace, connecting it first if needed
#   omarchy-context cycle                      next occupied workspace on the left monitor (5..8)
#   omarchy-context chat <slack|teams|teams-bss> show/hide that chat app, omamail-style
#   omarchy-context zen                        focus Zen, or start it
#   omarchy-context meeting                    toggle do-not-disturb; leaving it replays what came in
#   omarchy-context notes                      focus omawrite, or start it
#
# Fixed workspaces, one job each -- no per-client contexts any more. The client split
# lives inside the apps instead: Zen spaces + containers, herdr workspaces per devbox.
#
#   main (landscape)   1 herdr   2 VS Code + Zed   3-4 free (screens to share in a call)
#   left (portrait)    5 Zen     6 Lanvera VM      7 BSS VM      8 F5 (Pythian) VM
#   laptop             9 meetings (Chrome, Meet/Zoom)   10 free
#
# Chat apps never own a workspace: each one lives on its own special workspace and is
# only shown to reply, then hidden again (SUPER+ALT+S Slack / A Lanvera Teams / D BSS Teams).
# Workspace -> monitor is owned by hyprmoncfg (by monitor description, so connector
# names may swap freely); window -> workspace by the rules in overrides/omarchy-overrides.lua.
set -u

CLOUDPC='/home/daniel/repos/daniel/omarchy-overrides/bin/omarchy-cloudpc'

# Cloud PCs are named after the sub-client: Pythian's is "f5", because Pythian will
# bring more of them.
vm_ws() {
  case "$1" in
  lanvera) echo 6 ;;
  bss) echo 7 ;;
  f5) echo 8 ;;
  *) return 1 ;;
  esac
}

# special workspace <TAB> window class <TAB> launch command
chat_app() {
  case "$1" in
  slack) printf 'slack\tslack\t%s\n' 'uwsm-app -- slack --enable-features=UseOzonePlatform --ozone-platform=wayland' ;;
  teams) printf 'teams\tteams-for-linux\t%s\n' 'uwsm-app -- teams-for-linux' ;;
  # BSS Teams; class/data-dir keep the old "personal" name on purpose
  teams-bss) printf 'teams-bss\tteams-personal\t%s\n' 'uwsm-app -- teams-for-linux --class=teams-personal --user-data-dir=/home/daniel/.config/teams-personal' ;;
  *) return 1 ;;
  esac
}

running() { hyprctl clients -j | jq -e --arg c "$1" 'any(.[]; .class==$c)' >/dev/null; }
go() { hyprctl dispatch "hl.dsp.focus({ workspace = \"$1\" })" >/dev/null; }
special_shown() { hyprctl monitors -j | jq -e --arg s "special:$1" 'any(.[]; .specialWorkspace.name==$s)' >/dev/null; }
toggle_special() { hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$1\")" >/dev/null; }

# A connect costs two browser logins and the window only maps after them, so "is it
# running" has to look at the process, not the window -- otherwise a second press
# during login starts a second connection.
vm() {
  local ws
  ws=$(vm_ws "$1") || { echo "unknown cloud PC: $1" >&2; exit 1; }
  if ! running "cloudpc-$1" && ! pgrep -f "omarchy-cloudpc $1\$|sdl-freerdp3 .*/$1\.rdp" >/dev/null; then
    setsid "$CLOUDPC" "$1" >/dev/null 2>&1 &
  fi
  go "$ws"
}

# Next occupied workspace among the left monitor's 5..8 (Zen, then whichever VMs are up),
# wrapping. Landing from another monitor starts at the first one.
cycle_left() {
  local ws
  ws=$(hyprctl workspaces -j | jq -r '[.[]|select(.id>=5 and .id<=8 and .windows>0)|.id]|sort|.[]' |
    awk -v cur="$(hyprctl activeworkspace -j | jq -r .id)" '
      { ws[NR] = $0; if ($0 == cur) at = NR }
      END { if (NR) print (at == 0 || at == NR) ? ws[1] : ws[at + 1] }
    ')
  [ -n "$ws" ] && go "$ws"
}

chat() {
  local special class cmd addr
  IFS=$'\t' read -r special class cmd < <(chat_app "$1") || { echo "unknown chat app: $1" >&2; exit 1; }
  if special_shown "$special"; then
    toggle_special "$special"
    return
  fi
  # Closing an Electron chat window hides it to the tray, which unmaps it. Launching
  # again hands off to the running instance and maps the window back (into its
  # special workspace, via the window rule).
  if ! running "$class"; then
    setsid sh -c "$cmd" >/dev/null 2>&1 &
    for _ in $(seq 40); do
      sleep 0.25
      running "$class" && break
    done
  fi
  # Window rules only fire at map time; drag back anything that ended up elsewhere.
  for addr in $(hyprctl clients -j | jq -r --arg c "$class" --arg s "special:$special" '.[]|select(.class==$c and .workspace.name!=$s)|.address'); do
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:$special\", follow = false })" >/dev/null
  done
  toggle_special "$special"
}

case "${1:-}" in
vm) vm "${2:-}" ;;
cycle) cycle_left ;;
chat) chat "${2:-}" ;;
zen)
  # Not omarchy-launch-or-focus: it also matches titles, so any window mentioning
  # "zen" (a terminal, a chat) would steal the focus.
  addr=$(hyprctl clients -j | jq -r 'first(.[]|select(.class=="zen")|.address) // empty')
  if [ -n "$addr" ]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
  else
    setsid uwsm-app -- zen-browser >/dev/null 2>&1 &
  fi
  ;;
meeting)
  # Silenced notifications land in the shell's history, so leaving the meeting
  # replays them instead of losing them.
  state=$(omarchy-shell notifications toggleDnd 2>/dev/null)
  omarchy-shell -q omarchy.indicators refresh
  case "$state" in *off*) omarchy-shell -q notifications showHistory ;; esac
  ;;
notes)
  addr=$(hyprctl clients -j | jq -r 'first(.[]|select(.class=="omawrite")|.address) // empty')
  if [ -n "$addr" ]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
  else
    setsid uwsm-app -- omawrite >/dev/null 2>&1 &
  fi
  ;;
--dry-run)
  [ "$(vm_ws lanvera)$(vm_ws bss)$(vm_ws f5)" = 678 ] || { echo "FAIL: cloud PCs should sit on 6/7/8"; exit 1; }
  vm_ws pythian >/dev/null && { echo "FAIL: Pythian's cloud PC is f5"; exit 1; }
  for a in slack teams teams-bss; do
    chat_app $a | awk -F'\t' 'NF!=3 { exit 1 }' || { echo "FAIL: chat app $a is malformed"; exit 1; }
  done
  [ "$(chat_app teams-bss | cut -f2)" = teams-personal ] || { echo "FAIL: BSS Teams must keep the teams-personal class"; exit 1; }
  echo "ok"
  ;;
*)
  sed -n '2,9p' "$0"
  exit 1
  ;;
esac
