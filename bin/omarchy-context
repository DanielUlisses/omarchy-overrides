#!/bin/bash
# Per-client context switcher for Omarchy Quattro (Hyprland 0.56+).
#
#   omarchy-context switch <1-4>   move DP-5 + DP-6 to that context (repeat = toggle DP-5 layer)
#   omarchy-context launch <1-4>   idempotently start that context's apps, then switch
#   omarchy-context quit   <1-4>   close that context's windows
#   omarchy-context toggle         toggle DP-5 comms <-> cloud for the current context
#   omarchy-context focus          fullscreen current window + toggle notification silencing
#   omarchy-context notes          omawrite overlay on special:notes
#
# Workspaces: DP-6 = 1..4 (dev), DP-5 = 21..24 (comms) / 31..33 (cloud PC), eDP-1 = 10 (never touched).
# Placement is owned by the window rules in overrides/omarchy-overrides.lua, except for
# Chrome windows -- see is_chrome() below for why those have to be placed here.
set -u

DEV=DP-6
COMMS=DP-5

CHROME='uwsm app -- google-chrome-stable'
# Cloud PC AVD web clients.
BSS_AVD='https://windows.cloud.microsoft/webclient/avd/21b5393e-0ca5-4788-9ad2-3dafc22b0377/a026d301-402a-4b1d-d40a-08d8386745f7#loginHint=daniel.Ulisses.external%40Beiersdorf.com'
LANVERA_AVD='https://windows.cloud.microsoft/webclient/avd/69350a1c-2543-4664-8ea9-d3850d5b2216/4b4019bc-77c4-408a-e788-08dbde32b101?endpointId=d136289c-954b-4134-92f0-ed117198fdbd#loginHint=TE.DU0816%40Lanvera.org'

# window class <TAB> workspace <TAB> launch command, one line per app.
apps() {
  case "$1" in
  1) cat <<EOF
slack	21	uwsm app -- slack --enable-features=UseOzonePlatform --ozone-platform=wayland
chrome-pythian	21	$CHROME --profile-directory="Profile 1" --class=chrome-pythian
org.remmina.Remmina	31	uwsm app -- remmina -c "/home/daniel/.local/share/remmina/group_rdp_pythian_172-16-0-16.remmina"
EOF
    ;;
  2) cat <<EOF
teams-for-linux	22	uwsm app -- teams-for-linux
chrome-lanvera	22	$CHROME --profile-directory="Profile 2" --class=chrome-lanvera
chrome-cloudpc-lanvera	32	omarchy-launch-webapp "$LANVERA_AVD" --profile-directory="Profile 2"
EOF
    ;;
  3) cat <<EOF
teams-personal	23	uwsm app -- teams-for-linux --class=teams-personal --user-data-dir="/home/daniel/.config/teams-personal"
chrome-bss	23	$CHROME --profile-directory="Profile 3" --class=chrome-bss
chrome-cloudpc-bss	33	${BSS_AVD:+omarchy-launch-webapp "$BSS_AVD" --profile-directory="Profile 3"}
EOF
    ;;
  4) cat <<EOF
chrome-personal	24	$CHROME --profile-directory="Default" --class=chrome-personal
chrome-admin	24	$CHROME --profile-directory="Profile 4" --class=chrome-admin
EOF
    ;;
  esac
}

# Chrome shares one process across profiles, so every normal window inherits the
# app_id of whichever profile started the process -- window rules cannot tell them
# apart. Anything labelled chrome-* is therefore placed by this script instead.
is_chrome() { case "$1" in chrome-*) return 0 ;; *) return 1 ;; esac; }
chrome_on_ws() { hyprctl clients -j | jq --arg w "$1" '[.[]|select(.workspace.name==$w and (.class|startswith("chrome-")))]|length'; }
chrome_wanted() { apps "$1" | awk -F'\t' -v w="$2" '$1 ~ /^chrome-/ && $2 == w && $3 != "" {n++} END {print n+0}'; }

# Highest cloud-PC context. 4 (Personal) has none, so its F-key never toggles a layer.
CLOUD_MAX=3

active_ws() { hyprctl monitors -j | jq -r --arg m "$1" '.[]|select(.name==$m)|.activeWorkspace.name'; }
running() { hyprctl clients -j | jq -e --arg c "$1" 'any(.[]; .class==$c)' >/dev/null; }
go() { hyprctl dispatch "hl.dsp.focus({ workspace = \"$1\" })" >/dev/null; }

# Which context are we in? DP-6 is authoritative; fall back to DP-5, then Pythian.
current() {
  case "$(active_ws $DEV)" in 1 | 2 | 3 | 4) active_ws $DEV; return ;; esac
  case "$(active_ws $COMMS)" in
  2[1-4] | 3[1-3]) active_ws $COMMS | cut -c2 ;;
  *) echo 1 ;;
  esac
}

# DP-5 target: comms (2n), unless we are already sitting on it, in which case flip to cloud (3n).
comms_target() {
  if [ "$(active_ws $COMMS)" = "2$1" ] && [ "$1" -le "$CLOUD_MAX" ]; then echo "3$1"; else echo "2$1"; fi
}

switch() {
  go "$(comms_target "$1")" # DP-5 first...
  go "$1"                   # ...so focus ends on the dev monitor.
}

# hl.dsp.window.move has no `match`, so park = focus the window, then move the focused one.
park() {
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"$2\", follow = false })" >/dev/null
}

# Launch, wait for the window to map, then park it on its workspace.
place_new() {
  local before new addr
  before=$(hyprctl clients -j | jq -r '.[].address' | sort)
  setsid sh -c "$1" >/dev/null 2>&1 &
  for _ in $(seq 30); do
    sleep 0.5
    new=$(comm -13 <(echo "$before") <(hyprctl clients -j | jq -r '.[].address' | sort))
    [ -n "$new" ] && break
  done
  for addr in $new; do park "$addr" "$2"; done
}

# Window rules only fire at map time, so a window that was already open when a rule
# changed stays put. Drag any stragglers back rather than making you restart the app.
regroup() {
  local addr
  for addr in $(hyprctl clients -j | jq -r --arg c "$1" --arg w "$2" '.[]|select(.class==$c and .workspace.name!=$w)|.address'); do
    park "$addr" "$2"
  done
}

launch() {
  local class ws cmd
  while IFS=$'\t' read -r class ws cmd; do
    [ -n "$cmd" ] || continue # unwired entry, e.g. the BSS cloud PC before its URL is set
    if is_chrome "$class"; then
      # ponytail: no per-profile handle exists, so idempotency is "enough Chrome
      # windows already on that workspace". Close one of two and both relaunch.
      [ "$(chrome_on_ws "$ws")" -ge "$(chrome_wanted "$1" "$ws")" ] && continue
      place_new "$cmd" "$ws"
    elif running "$class"; then
      regroup "$class" "$ws"
    else
      setsid sh -c "$cmd" >/dev/null 2>&1 &
      sleep 0.8 # stagger: simultaneous Electron/RDP window mapping misplaces windows
    fi
  done < <(apps "$1")
  go "2$1" # launching always lands on comms, never flips to the cloud layer
  go "$1"
}

quit() {
  local class ws _cmd addr
  while IFS=$'\t' read -r class ws _cmd; do
    if is_chrome "$class"; then
      # No usable class, so close by what is sitting on the workspace instead.
      for addr in $(hyprctl clients -j | jq -r --arg w "$ws" '.[]|select(.workspace.name==$w and (.class|startswith("chrome-")))|.address'); do
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
        hyprctl dispatch 'hl.dsp.window.close()' >/dev/null
      done
    else
      hyprctl dispatch "hl.dsp.window.close({ match = \"class:^($class)$\" })" >/dev/null
    fi
  done < <(apps "$1")
}

case "${1:-}" in
switch) switch "$2" ;;
launch) launch "$2" ;;
quit) quit "${2:-$(current)}" ;;
toggle) switch "$(current)" ;;
focus)
  hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "fullscreen" })' >/dev/null
  # ponytail: two independent states (per-window fullscreen, global DND flag). Pressing
  # F9 on a different window fullscreens it while flipping DND back off. Reconcile only
  # if that actually bites.
  omarchy toggle notification silencing
  ;;
notes)
  running omawrite || { setsid sh -c 'uwsm app -- omawrite' >/dev/null 2>&1 & sleep 1; }
  hyprctl dispatch 'hl.dsp.workspace.toggle_special("notes")' >/dev/null
  ;;
--dry-run)
  # Self-check: context -> workspace mapping and the comms/cloud flip.
  for n in 1 2 3 4; do
    [ "$(apps $n | wc -l)" -ge 2 ] || { echo "FAIL: context $n has no apps"; exit 1; }
    apps $n | awk -F'\t' 'NF!=3 { exit 1 }' || { echo "FAIL: context $n has a malformed app line"; exit 1; }
  done
  hyprctl() { echo '[{"name":"DP-5","activeWorkspace":{"name":"'"$FAKE_WS"'"}}]'; }
  FAKE_WS=1 && [ "$(comms_target 2)" = 22 ] || { echo "FAIL: cold switch should go to comms"; exit 1; }
  FAKE_WS=22 && [ "$(comms_target 2)" = 32 ] || { echo "FAIL: repeat press should flip to cloud"; exit 1; }
  FAKE_WS=32 && [ "$(comms_target 2)" = 22 ] || { echo "FAIL: cloud should flip back to comms"; exit 1; }
  FAKE_WS=24 && [ "$(comms_target 4)" = 24 ] || { echo "FAIL: Personal has no cloud layer"; exit 1; }
  [ "$(chrome_wanted 4 24)" = 2 ] || { echo "FAIL: Personal should want 2 Chrome windows on 24"; exit 1; }
  [ "$(chrome_wanted 3 33)" = "$([ -n "$BSS_AVD" ] && echo 1 || echo 0)" ] || { echo "FAIL: unwired BSS cloud PC should not be counted"; exit 1; }
  echo "ok"
  ;;
*)
  sed -n '2,12p' "$0"
  exit 1
  ;;
esac
