#!/bin/bash
# The daily assistant (~/repos/daniel/secretary, started by its start.sh) as a drop-down
# on SUPER+ALT+S: a foot window parked on special:secretary, floating across the top of
# the screen. First press starts it, later presses show and hide it; quitting Claude
# drops to a shell in the repo so the window survives. Linux twin of the wsl branch's
# Win+Ctrl+S AutoHotkey drop-down. Placement rule: overrides/omarchy-overrides.lua.
set -u
REPO=/home/daniel/repos/daniel/secretary

addr() { hyprctl clients -j | jq -r 'first(.[] | select(.class == "secretary") | .address) // empty'; }

# The window rule's size/move resolve once, against whatever monitor the hidden special
# workspace sits on at map time (often the portrait one), and the window keeps that
# geometry when the special is later shown on another monitor: too tall, shifted up, only
# its bottom visible. So re-fit it to the monitor actually showing it, every time.
fit() {
  local a=$1 geo
  geo=$(hyprctl monitors -j | jq -r '
    first(.[] | select(.specialWorkspace.name == "special:secretary")) // empty
    | .scale as $s
    | (if .transform % 2 == 1 then [.height, .width] else [.width, .height] end
       | map(. / $s)) as [$w, $h]
    | [(.x + $w * 0.05), (.y + $h * 0.03), ($w * 0.9), ($h * 0.6)] | map(floor) | @tsv
  ')
  [ -n "$geo" ] || return 0
  read -r x y w h <<<"$geo"
  hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, relative = false, window = \"address:$a\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = \"address:$a\" })" >/dev/null
}

a=$(addr)
if [ -z "$a" ]; then
  # bash -i so mise (claude) is on PATH, as in any terminal.
  setsid uwsm-app -- xdg-terminal-exec --app-id=secretary --dir="$REPO" \
    -e bash -ic "cd '$REPO' && ./start.sh; exec bash" >/dev/null 2>&1 &
  for _ in $(seq 50); do a=$(addr); [ -n "$a" ] && break; sleep 0.1; done
  # Already showing special:secretary: the new window maps into it, nothing to toggle.
  if hyprctl monitors -j | jq -e 'any(.[]; .specialWorkspace.name == "special:secretary")' >/dev/null; then
    [ -n "$a" ] && fit "$a"
    exit 0
  fi
fi
hyprctl dispatch 'hl.dsp.workspace.toggle_special("secretary")' >/dev/null
[ -n "$a" ] && fit "$a"
