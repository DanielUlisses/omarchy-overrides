#!/usr/bin/env bash

# Record every main repo under ~/repos/<client>/<repo> into installations/repos.tsv, which
# installations/wsl-clone-repos.sh replays on another machine. Run it on the machine that
# has the work, commit the TSV, pull it on the other one.
#
# Worktrees (.git is a file) are skipped: only main repos are recreated. Repos without an
# origin remote cannot be cloned and are reported instead of recorded.

set -euo pipefail

REPOS_ROOT="${REPOS_ROOT:-$HOME/repos}"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$REPO_DIR/installations/repos.tsv"

{
  echo "# Generated by bin/repos-snapshot -- replayed by installations/wsl-clone-repos.sh"
  echo "# path (under ~/repos)	origin	branch	extra remotes (name=url,...)	local user.email"
  for git_dir in "$REPOS_ROOT"/*/*/.git; do
    [ -d "$git_dir" ] || continue
    repo="$(dirname "$git_dir")"
    rel="${repo#"$REPOS_ROOT"/}"

    origin=$(git -C "$repo" remote get-url origin 2>/dev/null) || {
      echo "SKIPPED $rel: no origin remote, it cannot be cloned" >&2
      continue
    }
    branch=$(git -C "$repo" branch --show-current)
    extra=$(git -C "$repo" remote -v | awk '$3 == "(fetch)" && $1 != "origin" { print $1 "=" $2 }' | paste -sd, -)
    email=$(git -C "$repo" config --local user.email || true)

    printf '%s\t%s\t%s\t%s\t%s\n' "$rel" "$origin" "${branch:--}" "${extra:--}" "${email:--}"
  done
} >"$OUT"

echo "Wrote $(grep -vc '^#' "$OUT") repos to $OUT"
